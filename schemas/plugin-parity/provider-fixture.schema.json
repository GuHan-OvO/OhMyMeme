{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohmymeme.local/schemas/plugin-parity/provider-fixture.schema.json",
  "title": "OhMyMeme provider characterization fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "current_identifier", "flow", "state", "paths", "protocols", "abi_aliases", "package_root", "license_provenance", "allowed_variance"],
  "properties": {
    "id": {"type": "string", "pattern": "^(source|sync|transport)\\.[a-z0-9]+$"},
    "current_identifier": {"type": "string", "minLength": 1},
    "flow": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "state": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "protocols": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "abi_aliases": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "package_root": {"type": "string", "pattern": "^ohmymeme_plugin_[a-z0-9_]+$"},
    "license_provenance": {"type": "string", "minLength": 1},
    "allowed_variance": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
  },
  "x-canonical-states": {"source.qqnt":["idle","checking","copying","done","error","cancelled"],"source.telegram":["idle","scanning","loading_key","decrypting","converting","deduping","importing","done","error","cancelled"],"source.douyin":["idle","running","done","error","cancelled"],"source.wechat":["idle","scanning","querying","extracting_key","decrypting_db","downloading","importing","done","error","cancelled"],"sync.ftp":["idle","connecting","uploading","downloading","deleting","done","error","cancelled"],"sync.s3":["idle","connecting","uploading","downloading","deleting","done","error","cancelled"],"sync.r2":["idle","connecting","uploading","downloading","deleting","done","error","cancelled"],"sync.webdav":["idle","connecting","uploading","downloading","deleting","done","error","cancelled"],"transport.lan":["stopped","starting","listening","handshaking","awaiting_confirmation","connected","stopping","done","error"]},
  "x-canonical-actions": {"source.qqnt":["check_env","start","get_progress","cancel"],"source.telegram":["pick_tdata","start","get_progress","cancel"],"source.douyin":["start","get_progress","cancel"],"source.wechat":["inspect_environment","start","get_progress","cancel"],"sync.ftp":["push","pull","test","get_progress"],"sync.s3":["push","pull","test","get_progress"],"sync.r2":["push","pull","test","get_progress"],"sync.webdav":["push","pull","test","get_progress"],"transport.lan":["start","stop","get_status","confirm_device","set_allow_secret_config"]}
}
