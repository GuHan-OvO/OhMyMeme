{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohmymeme.local/schemas/plugin/release-compatibility.schema.json",
  "title": "OhMyMeme offline release and legacy configuration compatibility",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "host", "release_catalog", "frozen_plugin_update", "source_editable"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "host": {"$ref": "#/$defs/host"},
    "release_catalog": {"$ref": "#/$defs/release_catalog"},
    "frozen_plugin_update": {"$ref": "#/$defs/frozen_plugin_update"},
    "source_editable": {"$ref": "#/$defs/source_editable"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "final_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_entrypoint", "updater_entrypoints", "manifest_path", "manifest_sha256"],
      "properties": {
        "runtime_entrypoint": {"const": "ohmymeme.app.bootstrap"},
        "updater_entrypoints": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["check_latest_cached", "start_download", "run_downloaded_installer"]}
        },
        "manifest_path": {"const": "ohmymeme/config/plugin-manifest.json"},
        "manifest_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "asset_name", "asset_url", "sha256", "architecture"],
      "properties": {
        "platform": {"enum": ["windows-x86_64", "linux-x86_64-appimage", "linux-x86_64-deb", "linux-x86_64-rpm", "macos-arm64", "macos-x86_64"]},
        "asset_name": {"type": "string", "minLength": 1},
        "asset_url": {"type": "string", "pattern": "^https://example\\.invalid/"},
        "sha256": {"$ref": "#/$defs/hash"},
        "architecture": {"type": "string", "minLength": 1}
      }
    },
    "stable_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "channel", "prerelease", "assets"],
      "properties": {
        "version": {"$ref": "#/$defs/final_version"},
        "channel": {"const": "stable"},
        "prerelease": {"type": "boolean", "const": false},
        "assets": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/asset"}}
      }
    },
    "nightly_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_name", "asset_url", "sha256"],
      "properties": {
        "asset_name": {"type": "string", "minLength": 1},
        "asset_url": {"type": "string", "pattern": "^https://example\\.invalid/"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "nightly_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "channel", "prerelease", "updater_selectable", "assets"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-nightly$"},
        "channel": {"const": "nightly"},
        "prerelease": {"type": "boolean", "const": true},
        "updater_selectable": {"type": "boolean", "const": false},
        "assets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nightly_asset"}}
      }
    },
    "asset_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "asset_name", "asset_url", "sha256"],
      "properties": {
        "version": {"$ref": "#/$defs/final_version"},
        "asset_name": {"type": "string", "minLength": 1},
        "asset_url": {"type": "string", "pattern": "^https://example\\.invalid/"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "target_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "candidate_input", "rollback_input"],
      "properties": {
        "target": {"enum": ["windows-x64", "linux-appimage-x64", "linux-deb-amd64", "linux-rpm-x64", "macos-arm64", "macos-x86_64"]},
        "candidate_input": {"$ref": "#/$defs/asset_input"},
        "rollback_input": {"$ref": "#/$defs/asset_input"}
      }
    },
    "release_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "releases", "ignored_releases", "target_matrix"],
      "properties": {
        "verdict": {"const": "pass"},
        "releases": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/stable_release"}},
        "ignored_releases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nightly_release"}},
        "target_matrix": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/target_input"}}
      }
    },
    "host_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "ohmymeme/config/plugin-manifest.json"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "plugin_update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "package_root", "api_version", "module_path", "frozen_path", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "package_root": {"type": "string", "minLength": 1},
        "api_version": {"type": "integer", "const": 1},
        "module_path": {"type": "string", "minLength": 1},
        "frozen_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "frozen_plugin_update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "version", "atomic", "activation_after_verify", "host_manifest", "plugins"],
      "properties": {
        "channel": {"const": "stable"},
        "version": {"$ref": "#/$defs/final_version"},
        "atomic": {"type": "boolean", "const": true},
        "activation_after_verify": {"type": "boolean", "const": true},
        "host_manifest": {"$ref": "#/$defs/host_manifest"},
        "plugins": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/plugin_update"}}
      }
    },
    "source_editable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "independent_updates", "official_ids"],
      "properties": {
        "mode": {"const": "source-editable"},
        "independent_updates": {"type": "boolean", "const": false},
        "official_ids": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "key", "legacy_key", "secret"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "key": {"type": "string", "minLength": 1},
        "legacy_key": {"type": "string", "minLength": 1},
        "secret": {"type": "boolean"}
      }
    },
    "setting_values": {
      "type": "object",
      "additionalProperties": {"type": ["string", "integer", "boolean"]}
    },
    "legacy_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "version", "flat", "secrets", "plugins", "mappings", "database", "expected"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "version": {"$ref": "#/$defs/final_version"},
        "flat": {"$ref": "#/$defs/setting_values"},
        "secrets": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "plugins": {"type": "object", "additionalProperties": {"$ref": "#/$defs/setting_values"}},
        "mappings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mapping"}},
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["filename"],
          "properties": {"filename": {"type": "string", "minLength": 1}}
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["copy_resize_mode", "version"],
          "properties": {
            "copy_resize_mode": {"type": "integer", "const": 0},
            "version": {"$ref": "#/$defs/final_version"}
          }
        }
      }
    }
  }
}
