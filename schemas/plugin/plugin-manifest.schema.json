{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohmymeme.local/schemas/plugin/plugin-manifest.schema.json",
  "title": "OhMyMeme v1 plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "entry_point_group", "plugins"],
  "properties": {
    "api_version": {"const": 1},
    "entry_point_group": {"const": "ohmymeme.plugins.v1"},
    "plugins": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {"$ref": "#/$defs/plugin"}
    }
  },
  "$defs": {
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_version", "capabilities", "entry_point", "id", "package_root"],
      "properties": {
        "api_version": {"const": 1},
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "device.approval",
              "filesystem.read",
              "import.submit",
              "lan.byte-transport",
              "lan.commands",
              "lan.replay-policy",
              "lan.secure-session",
              "lan.security",
              "network.https",
              "network.remote",
              "persistence.write",
              "process.ffmpeg",
              "process.helper",
              "sync.remote"
            ]
          }
        },
        "entry_point": {
          "type": "object",
          "additionalProperties": false,
          "required": ["group", "name", "value"],
          "properties": {
            "group": {"const": "ohmymeme.plugins.v1"},
            "name": {"type": "string", "minLength": 1},
            "value": {"type": "string", "pattern": "^ohmymeme_plugin_[a-z0-9_]+:create_plugin$"}
          }
        },
        "id": {
          "enum": [
            "source.douyin",
            "source.qqnt",
            "source.telegram",
            "source.wechat",
            "sync.ftp",
            "sync.r2",
            "sync.s3",
            "sync.webdav",
            "transport.lan"
          ]
        },
        "package_root": {"pattern": "^ohmymeme_plugin_[a-z0-9_]+$"}
      }
    }
  }
}
