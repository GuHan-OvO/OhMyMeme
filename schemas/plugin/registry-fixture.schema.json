{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohmymeme.local/schemas/plugin/registry-fixture.schema.json",
  "title": "OhMyMeme plugin registry fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "builtins", "entry_points", "expected", "load", "start"],
  "properties": {
    "api_version": {"const": 1},
    "builtins": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "entry_points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group", "name", "value"],
        "properties": {
          "group": {"type": "string"},
          "load_error": {"type": "string"},
          "name": {"type": "string"},
          "start_error": {"type": "string"},
          "value": {"type": "string"}
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quarantined", "sources"],
      "properties": {
        "quarantined": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "sources": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "load": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "start": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  }
}
