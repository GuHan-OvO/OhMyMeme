{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohmymeme.local/schemas/plugin/parity-report.schema.json",
  "title": "OhMyMeme Todo17 offline plugin parity report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "verdict",
    "allowed_variance",
    "errors",
    "input_hashes",
    "interception",
    "run_id"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {
      "enum": [
        "provider_capture",
        "ui_capture",
        "parity_comparison",
        "ui_comparison"
      ]
    },
    "variant": {"enum": ["baseline", "recomposed"]},
    "verdict": {"enum": ["pass", "changes_requested"]},
    "allowed_variance": {
      "type": "array",
      "items": {"type": "string"}
    },
    "errors": {
      "type": "array",
      "items": {"type": "string"}
    },
    "input_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "capture_inputs": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "capture_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "run_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "interception": {"type": "object"},
    "worktree": {"type": "object"},
    "providers": {"type": "array"},
    "registry": {"type": "object"},
    "durable_state": {"type": "object"},
    "durable_comparison": {"type": "object"},
    "failure_comparison": {"type": "object"},
    "viewport": {"const": "960x640"},
    "theme": {"const": "dark"},
    "browser": {"type": "object"},
    "browser_diagnostics": {"type": "object"},
    "ui": {"type": "object"},
    "ui_comparison": {"type": "object"},
    "cleanup": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "provider_capture"}}},
      "then": {
        "required": [
          "variant",
          "capture_inputs",
          "capture_sha256",
          "providers",
          "registry",
          "durable_state",
          "cleanup"
        ]
      }
    },
    {
      "if": {"properties": {"kind": {"const": "ui_capture"}}},
      "then": {
        "required": [
          "variant",
          "capture_inputs",
          "capture_sha256",
          "viewport",
          "theme",
          "browser",
          "ui",
          "cleanup"
        ]
      }
    },
    {
      "if": {"properties": {"kind": {"const": "parity_comparison"}}},
      "then": {
        "required": [
          "report_sha256",
          "durable_comparison",
          "ui_comparison",
          "failure_comparison"
        ]
      }
    },
    {
      "if": {"properties": {"kind": {"const": "ui_comparison"}}},
      "then": {"required": ["report_sha256", "ui_comparison"]}
    }
  ]
}
