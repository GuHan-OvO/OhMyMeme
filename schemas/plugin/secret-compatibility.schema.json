{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohmymeme.local/schemas/plugin/secret-compatibility.schema.json",
  "title": "OhMyMeme plugin configuration and secret compatibility",
  "type": "object",
  "additionalProperties": false,
  "required": ["lan_export_excluded", "providers", "schema_version"],
  "properties": {
    "schema_version": {"const": 1},
    "lan_export_excluded": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "providers": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {"$ref": "#/$defs/provider"}
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "namespace", "settings"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "pattern": "^plugins\\.[a-z0-9.]+$"},
        "settings": {
          "type": "array",
          "items": {"$ref": "#/$defs/setting"}
        }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "legacy_key", "secret"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "legacy_key": {"type": "string", "minLength": 1},
        "secret": {"type": "boolean"}
      }
    }
  }
}
