{
  "providers": [
    "source.qqnt",
    "source.telegram",
    "source.douyin",
    "source.wechat"
  ],
  "unavailable_sentinels": {
    "start_tg_import": {"ok": false},
    "get_tg_import_progress": {},
    "cancel_tg_import": null
  },
  "failure_cases": [
    "missing_provider",
    "disabled_provider",
    "incompatible_provider",
    "no_fallback_provider",
    "malformed_wrapper",
    "wrong_arguments"
  ],
  "production": {
    "requires_all_provider_descriptors": true,
    "requires_host_action_registry": true,
    "requires_entry_point_factory": true,
    "descriptors": [
      {
        "id": "source.qqnt",
        "api_version": 1,
        "package_root": "ohmymeme_plugin_qqnt",
        "entry_point": [
          "ohmymeme.plugins.v1",
          "source.qqnt",
          "ohmymeme_plugin_qqnt:create_plugin"
        ],
        "capabilities": ["filesystem.read", "import.submit"]
      },
      {
        "id": "source.telegram",
        "api_version": 1,
        "package_root": "ohmymeme_plugin_telegram",
        "entry_point": [
          "ohmymeme.plugins.v1",
          "source.telegram",
          "ohmymeme_plugin_telegram:create_plugin"
        ],
        "capabilities": [
          "filesystem.read",
          "import.submit",
          "process.ffmpeg"
        ]
      },
      {
        "id": "source.douyin",
        "api_version": 1,
        "package_root": "ohmymeme_plugin_douyin",
        "entry_point": [
          "ohmymeme.plugins.v1",
          "source.douyin",
          "ohmymeme_plugin_douyin:create_plugin"
        ],
        "capabilities": ["import.submit", "network.https"]
      },
      {
        "id": "source.wechat",
        "api_version": 1,
        "package_root": "ohmymeme_plugin_wechat",
        "entry_point": [
          "ohmymeme.plugins.v1",
          "source.wechat",
          "ohmymeme_plugin_wechat:create_plugin"
        ],
        "capabilities": [
          "filesystem.read",
          "import.submit",
          "network.https",
          "process.helper"
        ]
      },
      {
        "id": "sync.ftp",
        "api_version": 1,
        "package_root": "ohmymeme_plugin_sync_ftp",
        "entry_point": [
          "ohmymeme.plugins.v1",
          "sync.ftp",
          "ohmymeme_plugin_sync_ftp:create_plugin"
        ],
        "capabilities": ["network.remote", "sync.remote"]
      },
      {
        "id": "sync.s3",
        "api_version": 1,
        "package_root": "ohmymeme_plugin_sync_s3",
        "entry_point": [
          "ohmymeme.plugins.v1",
          "sync.s3",
          "ohmymeme_plugin_sync_s3:create_plugin"
        ],
        "capabilities": ["network.remote", "sync.remote"]
      },
      {
        "id": "sync.r2",
        "api_version": 1,
        "package_root": "ohmymeme_plugin_sync_r2",
        "entry_point": [
          "ohmymeme.plugins.v1",
          "sync.r2",
          "ohmymeme_plugin_sync_r2:create_plugin"
        ],
        "capabilities": ["network.remote", "sync.remote"]
      },
      {
        "id": "sync.webdav",
        "api_version": 1,
        "package_root": "ohmymeme_plugin_sync_webdav",
        "entry_point": [
          "ohmymeme.plugins.v1",
          "sync.webdav",
          "ohmymeme_plugin_sync_webdav:create_plugin"
        ],
        "capabilities": ["network.remote", "sync.remote"]
      },
      {
        "id": "transport.lan",
        "api_version": 1,
        "package_root": "ohmymeme_plugin_lan",
        "entry_point": [
          "ohmymeme.plugins.v1",
          "transport.lan",
          "ohmymeme_plugin_lan:create_plugin"
